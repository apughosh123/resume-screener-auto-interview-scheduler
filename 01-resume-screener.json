        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    model: \"openai/gpt-5.2\",\n    messages: [\n      {\n        role: \"system\",\n        content: \"You are an AI Resume Screening Assistant. Analyze the candidate resume against the applied job position. Do not invent qualifications or experience. Return valid JSON only.\"\n      },\n      {\n        role: \"user\",\n        content:\n          \"Candidate Name: \" + $('On form submission').item.json['Candidate Name'] +\n          \"\\nEmail: \" + $('On form submission').item.json['Email'] +\n          \"\\nJob Position: \" + $('On form submission').item.json['Job Position'] +\n          \"\\n\\nResume:\\n\" + $('Extract from File').item.json['text'] +\n          \"\\n\\nReturn JSON with these fields: candidate_name, email, job_position, match_score, shortlisted, skills, experience_summary, education, strengths, missing_requirements, reason. match_score must be 0-100.\"\n      }\n    ],\n    temperature: 0.2,\n    max_tokens: 1500\n  }\n}}",
        "options": {}
      },
